# Configuración de pnpm para el workspace completo

auto-install-peers=true
strict-peer-dependencies=false

# Medida de seguridad ante ataques a la cadena de suministro (supply chain):
# pnpm no instalará una versión de un paquete hasta que lleve al menos este
# tiempo publicada en el registro. Esto da margen para que npm/la comunidad
# detecte y retire versiones maliciosas antes de que lleguen a tu proyecto.
# (Requiere pnpm >= 9.4). Valor en minutos: 1440 = 24 horas.
minimum-release-age=1440
